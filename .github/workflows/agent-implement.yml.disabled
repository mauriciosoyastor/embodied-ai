name: Agent Implement

on:
  issues:
    types: [labeled]
  workflow_dispatch:
    inputs:
      issue_number:
        description: "Número del issue a implementar"
        required: true
        type: number
      pull_number:
        description: "Número del PR existente (re-runs del loop)"
        required: false
        type: number
      iteration:
        description: "Iteración actual del loop (1..3)"
        required: false
        type: number
        default: 1

concurrency:
  group: agent-issue-${{ github.event.issue.number || github.event.inputs.issue_number }}
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  implement:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    if: >
      github.event_name == 'workflow_dispatch'
      || (github.event.action == 'labeled'
          && github.event.label.name == 'ready-for-agent')
    steps:
      - name: Checkout
        uses: actions/checkout@v7
        with:
          ref: main

      - name: Create GitHub App token
        uses: actions/create-github-app-token@v3
        id: app-token
        with:
          client-id: ${{ vars.APP_CLIENT_ID }}
          private-key: ${{ secrets.APP_PRIVATE_KEY }}
          permission-contents: write
          permission-pull-requests: write
          permission-issues: write
          permission-checks: read

      - name: Prepare agent (contexto + rama + labels)
        id: prepare
        env:
          GH_TOKEN: ${{ steps.app-token.outputs.token }}
          APP_SLUG: ${{ steps.app-token.outputs.app-slug }}
          ISSUE_NUMBER: ${{ github.event.issue.number || github.event.inputs.issue_number }}
          PULL_NUMBER: ${{ github.event.inputs.pull_number || '' }}
          ITERATION: ${{ github.event.inputs.iteration || 1 }}
        run: |
          bash .github/scripts/run_agent.sh prepare

      - name: Instalar Claude Code CLI
        run: |
          curl -fsSL https://claude.ai/install.sh | bash
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"

      - name: Configurar git para push con app token
        run: |
          git remote set-url origin \
            "https://x-access-token:${APP_TOKEN}@github.com/${GITHUB_REPOSITORY}.git"
          git config user.name "${APP_SLUG}[bot]"
          git config user.email "${APP_SLUG}[bot]@users.noreply.github.com"
        env:
          APP_TOKEN: ${{ steps.app-token.outputs.token }}
          APP_SLUG: ${{ steps.app-token.outputs.app-slug }}

      - name: Levantar proxy LiteLLM (Anthropic -> NVIDIA)
        run: |
          pip install "litellm[proxy]==1.97.0" "fastapi==0.136.3" -q
          cat > /tmp/litellm.yaml <<'EOF'
          model_list:
            - model_name: nemotron
              litellm_params:
                model: nvidia_nim/deepseek-ai/deepseek-v4-flash-0731
                api_base: https://integrate.api.nvidia.com/v1
                api_key: os.environ/NVIDIA_API_KEY
          router_settings:
            retries: 5
            retry_strategy: exponential_backoff_retry
            cooldown_time: 5
          EOF
          litellm --config /tmp/litellm.yaml --port 4000 > /tmp/litellm.log 2>&1 &
          for i in $(seq 1 30); do
            if curl -sf http://127.0.0.1:4000/health/liveness >/dev/null 2>&1; then
              echo "Proxy LiteLLM listo"
              exit 0
            fi
            sleep 2
          done
          echo "Proxy LiteLLM no respondió" >&2
          tail -n 20 /tmp/litellm.log >&2
          exit 1
        env:
          NVIDIA_API_KEY: ${{ secrets.NVIDIA_API_KEY }}

      - name: Warm-up del modelo NVIDIA (evita cold-start 429)
        run: |
          for i in $(seq 1 10); do
            code=$(curl -s -o /tmp/warmup.json -w "%{http_code}" \
              -X POST http://127.0.0.1:4000/v1/messages \
              -H "Authorization: Bearer $NVIDIA_API_KEY" \
              -H "Content-Type: application/json" \
              -H "anthropic-version: 2023-06-01" \
              -d '{"model":"nemotron","max_tokens":8,"messages":[{"role":"user","content":"ping"}]}')
            if [ "$code" = "200" ]; then
              echo "Warm-up OK"
              exit 0
            fi
            echo "warm-up intento $i -> HTTP $code"
            sleep 5
          done
          echo "Warm-up falló tras 10 intentos" >&2
          tail -n 30 /tmp/litellm.log >&2
          exit 1
        env:
          NVIDIA_API_KEY: ${{ secrets.NVIDIA_API_KEY }}

      - name: Implementar con Claude (headless, vía proxy LiteLLM -> NVIDIA)
        run: |
          claude -p --bare --verbose --max-turns 100 --max-budget-usd 5 \
            --permission-mode acceptEdits \
            --allowedTools "Edit,Read,Write,Glob,Grep,Bash(git *),Bash(pip *),Bash(ruff *),Bash(mypy *),Bash(pytest *)" \
            < .agent-prompt.md
        env:
          ANTHROPIC_BASE_URL: http://127.0.0.1:4000
          ANTHROPIC_AUTH_TOKEN: ${{ secrets.NVIDIA_API_KEY }}
          ANTHROPIC_MODEL: nemotron
          GH_TOKEN: ${{ steps.app-token.outputs.token }}

      - name: Abrir o actualizar PR
        env:
          GH_TOKEN: ${{ steps.app-token.outputs.token }}
          ISSUE_NUMBER: ${{ github.event.issue.number || github.event.inputs.issue_number }}
          PULL_NUMBER: ${{ github.event.inputs.pull_number || '' }}
          ITERATION: ${{ github.event.inputs.iteration || 1 }}
        run: |
          bash .github/scripts/run_agent.sh open_pr
